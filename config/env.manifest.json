{
  "app": "mister-footcoach",
  "entries": [
    {
      "name": "VITE_BACKEND",
      "store": "vars",
      "phase": "build",
      "required": "optional",
      "purpose": "Choix de backend (local / supabase / …)"
    },
    {
      "name": "VITE_POSTHOG_KEY",
      "store": "vars",
      "phase": "build",
      "required": "optional",
      "purpose": "Clé projet PostHog (nuage EU)",
      "fallback": "absent : pas de mesure ni bandeau",
      "provider": "posthog"
    },
    {
      "name": "VITE_PUBLIC_SITE_ORIGIN",
      "store": "vars",
      "phase": "build",
      "required": "optional",
      "purpose": "Origine publique du site",
      "fallback": "souvent une expression GitHub dans deploy.yml"
    },
    {
      "name": "VITE_SENTRY_DSN",
      "store": "vars",
      "phase": "build",
      "required": "optional",
      "purpose": "DSN Sentry",
      "fallback": "absent : no-op",
      "provider": "sentry"
    },
    {
      "name": "VITE_SUPABASE_ANON_KEY",
      "store": "vars",
      "phase": "build",
      "required": "optional",
      "purpose": "Clé anon publique (RLS)",
      "provider": "supabase"
    },
    {
      "name": "VITE_SUPABASE_URL",
      "store": "vars",
      "phase": "build",
      "required": "optional",
      "purpose": "URL du projet Supabase",
      "provider": "supabase"
    },
    {
      "name": "VITE_VAPID_PUBLIC_KEY",
      "store": "vars",
      "phase": "build",
      "required": "optional",
      "purpose": "Clé publique VAPID (Web Push)",
      "provider": "web-push"
    }
  ]
}
