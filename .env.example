# Base URL (GitHub Pages)
VITE_PUBLIC_SITE_ORIGIN=https://mister-guiiug.github.io

# Mesure d'audience (optionnel) — clé de projet PostHog, nuage EUROPÉEN.
# La MÊME pour tout le parc : un seul projet, les applications distinguées
# dedans par `app_name`, que le socle déduit du chemin de base. Publique par
# conception. Absente, le bandeau de consentement ne rend rien.
# VITE_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXX

# ── Data backend ──────────────────────────────────────────────────────
# "local" (localStorage, défaut) ou "supabase"
VITE_BACKEND=local

# Projet Supabase (région Frankfurt / eu-central-1). Valeurs publiques,
# safe dans le bundle statique : la sécurité est assurée côté serveur (RLS).
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Notifications push (mode supabase, optionnel) — la clé PUBLIQUE VAPID, lue
# au build : publique par conception, elle part dans le bundle. La clé PRIVÉE
# ne va JAMAIS ici : elle vit dans les secrets de l'Edge Function `push`.
# Absente, le réglage « Notifications push » le dit, et rien ne part.
# Procédure : docs/supabase.md, « Notifications push ».
# VITE_VAPID_PUBLIC_KEY=BLxx...

# Optional: error monitoring via Sentry. Leave empty to disable (no-op,
# the @sentry/react peer is never loaded). Set your DSN to activate.
VITE_SENTRY_DSN=
