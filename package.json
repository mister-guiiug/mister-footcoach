{
  "name": "mister-footcoach",
  "description": "PWA coach de football : gestion d'équipes, compositions, statistiques, entraînements.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "cross-env ANALYZE=1 npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc -b",
    "supabase:setup": "node scripts/supabase-setup.mjs",
    "supabase:push": "supabase db push",
    "supabase:link": "supabase link",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "convex": "^1.37.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.6.0",
    "tailwindcss": "^4.2.2",
    "web-vitals": "^4.2.0"
  },
  "devDependencies": {
    "@mister-guiiug/dev-wpa-config": "^1.4.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.6",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "typescript": "~6.0.2",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.6"
  }
}
